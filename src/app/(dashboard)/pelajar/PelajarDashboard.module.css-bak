.container {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* KAD RINGKASAN TERATAS */
.summaryGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}

.summaryCard {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  gap: 1.25rem;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.summaryCard:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.iconWrapper {
  width: 50px;
  height: 50px;
  border-radius: var(--radius-md);
  background-color: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.summaryValue {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
}

.summaryLabel {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 0.25rem;
}

/* MURAJA'AH HARIAN (SABAQ, SABQI, MANZIL) */
.sectionTitle {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 1rem;
}

.tasmikGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}

.tasmikCard {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-top: 4px solid var(--primary);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.tasmikCard.sabqi { border-top-color: var(--secondary); }
.tasmikCard.manzil { border-top-color: #3b82f6; }

.tasmikHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
}

.badgeSabaq { background-color: var(--primary-light); color: var(--primary); }
.badgeSabqi { background-color: #fef3c7; color: var(--secondary); }
.badgeManzil { background-color: #dbeafe; color: #1d4ed8; }

.targetMeta {
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.surahTarget {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
}

.targetDetail {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 0.25rem;
}

/* CARTA & JADUAL */
.chartContainer {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
}

.tableContainer {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
  overflow-x: auto;
}

.table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.table th {
  padding: 0.75rem 1rem;
  border-bottom: 2px solid var(--border-color);
  font-size: 0.85rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  font-weight: 700;
  background-color: var(--bg-subtle);
}

.table td {
  padding: 1rem;
  border-bottom: 1px solid var(--border-color);
  font-size: 0.9rem;
  color: var(--text-primary);
}

.table tr:last-child td { border-bottom: none; }
.table tr:hover td { background-color: #f8fafc; }

.statusMutqan {
  color: var(--success);
  font-weight: 700;
}

@media (max-width: 640px) {
  .summaryGrid, .tasmikGrid { grid-template-columns: 1fr; }
  .table { min-width: 600px; }
}